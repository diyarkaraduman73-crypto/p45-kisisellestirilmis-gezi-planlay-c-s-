# Sunucu portu (Render bunu otomatik verir)
PORT=4000

# Turso veritabanı. Boş bırakılırsa API örnek verilerle (bellekte, salt okunur) çalışır.
#   Adres:  turso db show <veritabani> --url      → libsql://<veritabani>-<kullanici>.turso.io
#   Token:  turso db tokens create <veritabani>
# Yerelde dosya ile denemek için:  TURSO_DATABASE_URL=file:yerel.db  (token gerekmez)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Frontend adresi (CORS için). Birden fazla adres virgülle ayrılabilir.
CORS_ORIGIN=http://localhost:5173

# JWT imzalama anahtarı: EN AZ 32 karakter, rastgele ve GİZLİ. Depoya asla gerçek değer yazmayın.
# Üretmek için:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Oturum (token) süresi, dakika
SESSION_TTL_MINUTES=120

# Render'da "production" yapın (JWT_SECRET yoksa sunucu başlamaz)
NODE_ENV=development

# Sonraki haftalarda kullanılacak (yapay zekâ gezi planı)
GROQ_API_KEY=
