# Sunucu portu (Render bunu otomatik verir)
PORT=4000

# Neon PostgreSQL bağlantı adresi. Boş bırakılırsa API örnek verilerle (bellekte) çalışır.
DATABASE_URL=

# Frontend adresi (CORS için). Birden fazla adres virgülle ayrılabilir.
CORS_ORIGIN=http://localhost:5173

# JWT imzalama anahtarı: EN AZ 32 karakter, rastgele ve GİZLİ. Depoya asla gerçek değer yazmayın.
# Üretmek için:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Oturum (token) süresi, dakika
SESSION_TTL_MINUTES=120

# Render'da "production" yapın (JWT_SECRET yoksa sunucu başlamaz)
NODE_ENV=development

# --- Harici servisler (anahtarlar YALNIZCA burada / Render > Environment; depoya ve tarayıcıya gitmez) ---

# Harita (Hafta 9): openrouteservice (HeiGIT). Ücretsiz anahtar: https://account.heigit.org/signup
# Boş bırakılırsa harita duraklar arasını düz çizgiyle gösterir (uygulama yine çalışır).
ORS_API_KEY=
# Eski api.openrouteservice.org adresi 24.11.2026'da kapandı; değiştirmeniz gerekmez.
ORS_API_URL=https://api.heigit.org/openrouteservice

# Sonraki haftalarda kullanılacak (yapay zekâ gezi planı)
GROQ_API_KEY=
